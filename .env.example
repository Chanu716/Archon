# Database
POSTGRES_PASSWORD=archon_secret
NEO4J_PASSWORD=neo4j_secret

# LLM Config
# Supported providers: gemini, openrouter, groq, ollama
LLM_PROVIDER=ollama
LLM_MODEL=llama3

# Provider API keys (No keys required for Ollama)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Local Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings
# MUST NOT use OpenAI. Local Ollama embeddings required.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# Archon Settings
LOG_LEVEL=DEBUG
DEBUG=true
